# Copy to .env.local. Never commit real secrets.
# Dashboard → Project Settings → API: Project URL + publishable (or legacy anon) key.
# Do NOT put service_role / secret key in NEXT_PUBLIC_* or in the app bundle.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (same publishable/anon role) if your project still shows "anon":
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional absolute origin for password-recovery emails when Origin header is absent:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth → URL Configuration (dev), must match lib/auth/paths.ts:
# Site URL: http://localhost:3000
# Redirect URLs:
#   http://localhost:3000/auth/callback
#   http://127.0.0.1:3000/auth/callback
#
# Recovery flow in app:
#   reset email → /auth/callback?code=…&next=/auth/update-password
#   → exchangeCodeForSession → /auth/update-password
